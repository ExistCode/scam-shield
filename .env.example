# Names only. Put real values in Railway env vars (or a local .env that is git-ignored).
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_REASONING_EFFORT=low
ASR_MODEL=muse-voice-transcribe-1.0
LLM_PROVIDER=meta
# Escalation: re-run the final verdict with this model (same tool results) when Spark's confidence is
# below the threshold or the input is a video. Exact id from dev.meta.ai/docs/models. Empty = off.
MUSE_ESCALATION_MODEL=muse-wonder-1.0
MUSE_ESCALATION_THRESHOLD=0.6
MUSE_ESCALATION_REASONING_EFFORT=low
MUSE_ESCALATION_TIMEOUT=30
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_GRAPH_VERSION=v21.0
WA_GUARDIAN_TEMPLATE=guardian_alert
WA_TEMPLATE_LANG=id
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
DATABASE_URL=sqlite:///./cekdulu.db
GOOGLE_SAFE_BROWSING_KEY=
# Required to use POST /analyze (and the test page) on a deployed server; send as X-Analyze-Token
ANALYZE_TOKEN=
ANALYZE_RATE_PER_MIN=10
# Optional AduanNomor.id public lookup: live (default) | fixture (use captured responses only) | off
ADUANNOMOR_MODE=live
